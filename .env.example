# Server / Gateway
GATEWAY_PORT=5000
NODE_ENV=development

# Microservices
AUTH_SERVICE_PORT=5001
AUTH_SERVICE_URL=http://localhost:5001
PROGRAMS_SERVICE_PORT=5002
PROGRAMS_SERVICE_URL=http://localhost:5002
PAYMENTS_SERVICE_PORT=5003
PAYMENTS_SERVICE_URL=http://localhost:5003

# PostgreSQL
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/hunarbee

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# CORS (frontend origin)
CORS_ORIGIN=http://localhost:3000

# Razorpay (use test keys in development)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Dashboard → Account & Settings → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ExchangeRate-API (https://www.exchangerate-api.com/) — required for live FX
EXCHANGE_RATE_API_KEY=your_exchangerate_api_key

# SMTP — offer letter + portal credentials after enrollment
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_smtp_app_password
EMAIL_FROM=Hunarbee <noreply@hunarbee.com>
PORTAL_URL=http://localhost:3000/portal/login
